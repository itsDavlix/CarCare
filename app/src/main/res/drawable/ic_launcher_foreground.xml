        <path android:pathData="M50,50 L57.9,28.4"
            android:strokeColor="#E5484D" android:strokeWidth="4.5" android:strokeLineCap="round"
            android:fillColor="@android:color/transparent"/>
        <!-- Buje: disco rojo + punto petróleo -->
        <path android:pathData="M44.5,50 A5.5,5.5 0 1 0 55.5,50 A5.5,5.5 0 1 0 44.5,50 Z" android:fillColor="#E5484D"/>
        <path android:pathData="M47.8,50 A2.2,2.2 0 1 0 52.2,50 A2.2,2.2 0 1 0 47.8,50 Z" android:fillColor="#06302F"/>
